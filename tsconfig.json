{
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "lib": ["ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": [],
    "verbatimModuleSyntax": true
  },
  "include": ["src", "test"]
}
